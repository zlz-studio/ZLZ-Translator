# คัดลอกไฟล์นี้เป็น .env แล้วใส่คีย์ (เอาเครื่องหมาย # ข้างหน้าออก)
# ไฟล์ .env เป็นความลับ ห้ามแชร์หรือ commit

# Google Gemini (มีโควต้าฟรี) : https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Claude API แบบเติมเครดิต : https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Discord app token (สำหรับส่วน Discord ในขั้นถัดไป)
# DISCORD_TOKEN=
